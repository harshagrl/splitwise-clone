// Splitwise Clone — Complete Database Schema
// All IDs are UUIDs using PostgreSQL's gen_random_uuid()

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

// ─── Users ──────────────────────────────────────────────

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())

  // Relations
  groups_created       Group[]
  group_memberships    GroupMember[]
  expenses_paid        Expense[]      @relation("PaidBy")
  expense_splits       ExpenseSplit[]
  settlements_paid     Settlement[]   @relation("SettlementPaidBy")
  settlements_received Settlement[]   @relation("SettlementPaidTo")
  chat_messages        ChatMessage[]

  @@map("users")
}

// ─── Groups ─────────────────────────────────────────────

model Group {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  created_by_id String   @db.Uuid
  created_at    DateTime @default(now())

  // Relations
  created_by  User          @relation(fields: [created_by_id], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]

  @@map("groups")
}

// ─── Group Members (many-to-many) ───────────────────────

model GroupMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id  String   @db.Uuid
  user_id   String   @db.Uuid
  joined_at DateTime @default(now())

  // Relations
  group Group @relation(fields: [group_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  // Prevent duplicate memberships
  @@unique([group_id, user_id])
  @@map("group_members")
}

// ─── Expenses ───────────────────────────────────────────

model Expense {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String    @db.Uuid
  paid_by_id  String    @db.Uuid
  description String
  amount      Decimal   @db.Decimal(12, 2)
  split_type  SplitType
  created_at  DateTime  @default(now())

  // Relations
  group    Group          @relation(fields: [group_id], references: [id])
  paid_by  User           @relation("PaidBy", fields: [paid_by_id], references: [id])
  splits   ExpenseSplit[]
  messages ChatMessage[]

  @@map("expenses")
}

// ─── Expense Splits ─────────────────────────────────────
// Each row = one participant's OWED share of an expense
// amount = what this user owes (their share), NOT what they paid

model ExpenseSplit {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expense_id String  @db.Uuid
  user_id    String  @db.Uuid
  amount     Decimal @db.Decimal(12, 2)

  // Relations — cascade delete when expense is deleted
  expense Expense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id])

  @@map("expense_splits")
}

// ─── Settlements ────────────────────────────────────────
// Manual payment records (no payment gateway)
// paid_by sends money TO paid_to
// Partial settlements allowed

model Settlement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  paid_by_id String   @db.Uuid
  paid_to_id String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  created_at DateTime @default(now())

  // Relations
  group   Group @relation(fields: [group_id], references: [id])
  paid_by User  @relation("SettlementPaidBy", fields: [paid_by_id], references: [id])
  paid_to User  @relation("SettlementPaidTo", fields: [paid_to_id], references: [id])

  @@map("settlements")
}

// ─── Chat Messages ──────────────────────────────────────
// Per-expense comment threads (NOT group-level chat)
// Realtime subscriptions handled by Supabase (RLS disabled on this table)
// Write access enforced at Express API level

model ChatMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expense_id String   @db.Uuid
  user_id    String   @db.Uuid
  content    String
  created_at DateTime @default(now())

  // Relations — cascade delete when expense is deleted
  expense Expense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id])

  @@map("chat_messages")
}
